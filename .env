# API Configuration
APP_NAME="ANS Intelligence API"
APP_VERSION="1.0.0"
API_PREFIX="/api/v1"
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:8080"]

# Database (MySQL via Docker)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=ans_db

# Cache (Redis via Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=300

# Search
CADOP_CSV_PATH="etl/data/raw/operadoras_ativas/relatorio_cadop.csv"

# Security
SECRET_KEY="dev-secret-key-change-in-production-12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Notifications (deixe vazio por enquanto)
DISCORD_WEBHOOK_URL=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo