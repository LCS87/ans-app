# API Configuration
APP_NAME="ANS Intelligence API"
APP_VERSION="1.0.0"
API_PREFIX="/api/v1"
DEBUG=false

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Database
DATABASE_URL="mysql+mysqlconnector://user:password@localhost:3307/ans_db"

# Cache (Redis)
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL=300

# Search
CADOP_CSV_PATH="etl/data/raw/operadoras_ativas/relatorio_cadop.csv"

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY="your-secret-key-here-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
